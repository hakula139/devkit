# ==================================================================================================
# Hook Installation Check
# ==================================================================================================

{
  pkgs,
  preCommit,
}:

let
  inherit (pkgs) lib;

  # The sandbox cannot add GC roots, so the check supplies the config symlink itself.
  shellHook =
    lib.replaceStrings [ (lib.getExe' pkgs.nix "nix-store") ] [ "true" ]
      preCommit.shellHook;

  config = pkgs.writeText "pre-commit-config.yaml" ''
    repos:
      - repo: local
        hooks:
          - id: noop
            name: noop
            entry: 'true'
            language: system
            always_run: true
  '';
in
pkgs.runCommand "hooks-install"
  {
    nativeBuildInputs = [
      pkgs.git
      pkgs.pre-commit
      pkgs.prek
      pkgs.flock
    ];
  }
  ''
    export HOME="$TMPDIR/home"
    export PRE_COMMIT_HOME="$TMPDIR/pre-commit"
    export PREK_HOME="$TMPDIR/prek"
    mkdir -p "$out" "$HOME" "$PRE_COMMIT_HOME" "$PREK_HOME"

    repo="$TMPDIR/repo"
    mkdir -p "$repo"
    cd "$repo"
    git init --quiet
    git config user.email test@example.com
    git config user.name Test
    ln -s ${config} .pre-commit-config.yaml

    pre-commit install --config ${config} --hook-type pre-commit --hook-type pre-push
    grep -q 'File generated by pre-commit' .git/hooks/pre-commit

    ${shellHook}
    ${shellHook}

    test ! -e .git/hooks/pre-commit.legacy
    test ! -e .git/hooks/pre-push.legacy
    git commit --allow-empty --message check
  ''
