{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeCrate",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgePypi"
  ],
  "timezone": "Asia/Shanghai",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 4-8 * * *"]
  },
  "prConcurrentLimit": 3,
  "dependencyDashboard": false,
  "assignees": ["hakula139"],
  "assignAutomerge": true,
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/fixtures/**",
    "**/.mise/locks/**",
    "**/.config/mise/locks/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/", "**/!(CHANGELOG).md"],
      "matchStrings": [
        "(?:^|[^\\w-])hakulab/devkit/[\\w./-]+@(?<currentValue>v\\d+)[^.\\d]",
        "(?:^|[^\\w-])github>hakulab/devkit#(?<currentValue>v\\d+)[^.\\d]",
        "(?:^|[^\\w-])github:hakulab/devkit/(?<currentValue>v\\d+)[^.\\d]",
        "(?:^|[^\\w-])github\\.com/hakulab/devkit/(?:blob|tree)/(?<currentValue>v\\d+)[^.\\d]"
      ],
      "depNameTemplate": "hakulab/devkit",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^(?<version>v\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies",
      "automerge": true
    },
    {
      "matchManagers": ["rust-toolchain"],
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Node dependencies",
      "automerge": true
    },
    {
      "description": "Hold TypeScript below v7 until typescript-eslint supports it.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchManagers": ["nix"],
      "groupName": "flake inputs",
      "semanticCommitScope": "flake",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": ["hakulab/devkit"],
      "groupName": "devkit",
      "versioning": "github-actions"
    }
  ]
}
