{
  "version": "0.2",
  "language": "en",
  "enableGlobDot": true,
  "useGitignore": true,
  "gitignoreRoot": ".",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [".git", "flake.lock"],
  "overrides": [
    {
      "filename": ".github/settings/labels.json",
      "ignoreRegExpList": ["/\"color\":\\s*\"[0-9a-fA-F]{6}\"/g"]
    }
  ]
}
